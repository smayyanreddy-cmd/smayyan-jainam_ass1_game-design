rules_version = '2';
// PedalPace: Cloud Firestore security rules. Paste into Firebase console →
// Firestore Database → Rules, then Publish. See docs/SETUP_FIREBASE.md.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Player profiles: readable by every player (names, colours, scores for
    // leaderboards). Only you edit yours, except that another player may add or
    // remove *themselves* from your friends list.
    match /users/{uid} {
      function onlyFriendSelf() {
        let before = resource.data.get('friends', []).toSet();
        let after = request.resource.data.get('friends', []).toSet();
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends'])
          && after.difference(before).hasOnly([request.auth.uid])
          && before.difference(after).hasOnly([request.auth.uid]);
      }
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (request.auth.uid == uid || onlyFriendSelf());
      allow delete: if signedIn() && request.auth.uid == uid;

      // Notifications: anyone can drop you one; only you read or clear them.
      match /notifs/{id} {
        allow read, update, delete: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.resource.data.text is string && request.resource.data.text.size() <= 300;
      }
    }

    // Zones: owners create and edit their own. Anyone may only lower a zone's HP
    // (damage), and may delete a zone once it is at 0 HP (broken).
    match /zones/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow update: if signedIn() && (
        (resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hp', 'updated'])
            && request.resource.data.hp < resource.data.hp));
      allow delete: if signedIn() && (resource.data.owner == request.auth.uid || resource.data.hp <= 0);
    }

    // Live positions while on a trip: you write yours, players can read.
    match /live/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }
  }
}
